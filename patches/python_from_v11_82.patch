+        self.assertFalse(accepted('<p>¿Cuánto cuestan los implantes mamarios? '
+                                  'Precio por par de implantes 600–2000 €</p>', 'breast_augmentation'))
+
+    def test_owned_mamoplasty_heading_binds_its_starting_fee(self):
